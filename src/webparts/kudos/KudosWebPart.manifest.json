{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "a7c2d9f1-6e84-4b2a-9c3d-2f7b8e10a4c5",
  "alias": "KudosWebPart",
  "componentType": "WebPart",

  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "b1e7f3a2-9c4d-4e8b-a1f2-3d6c0e5a7b90", // custom group so all suite web parts sit together
    "group": { "default": "Intranet Suite" },
    "title": { "default": "Kudos" },
    "description": { "default": "A recognition wall where people can thank a colleague, saved to a SharePoint list." },
    "officeFabricIconFontName": "Trophy2",
    "properties": {
      "title": "Kudos",
      "layout": "card",
      "showPhoto": true,
      "showTitle": true,
      "showBorder": false,
      "backgroundMode": "transparent",
      "backgroundColor": "#eef3f8",
      "listTitle": "",
      "maxItems": 6,
      "useDemoData": true
    }
  }]
}
