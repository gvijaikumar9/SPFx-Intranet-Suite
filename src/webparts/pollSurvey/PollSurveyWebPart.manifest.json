{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "b8c0d2e4-6f70-4c9b-8e5d-2a3f4b6c8d60",
  "alias": "PollSurveyWebPart",
  "componentType": "WebPart",

  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "b1e7f3a2-9c4d-4e8b-a1f2-3d6c0e5a7b90",
    "group": { "default": "Intranet Suite" },
    "title": { "default": "Poll" },
    "description": { "default": "A quick one-question poll with live results, saved to a SharePoint list." },
    "officeFabricIconFontName": "OfficeFormsLogo",
    "properties": {
      "title": "Poll of the week",
      "layout": "card",
      "question": "What should we improve first?",
      "optionsText": "Cafeteria, Parking, Meeting rooms, Remote tools",
      "showTitle": true,
      "showBorder": false,
      "backgroundMode": "transparent",
      "backgroundColor": "#eef3f8",
      "listTitle": "",
      "useDemoData": true,
      "tileColorMode": "none"
    }
  }]
}
